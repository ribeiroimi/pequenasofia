# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub — só o ".env.example".

# ---------- Supabase ----------
# Painel Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# ---------- Anthropic (Claude — gera a história) ----------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-cole-aqui

# ---------- fal.ai (Flux — gera as ilustrações) ----------
# fal.ai → Dashboard → API Keys
FAL_API_KEY=cole-aqui

# ---------- Cakto ----------
# Painel Cakto → Apps → Webhooks → (ao criar o webhook, defina uma
# chave secreta qualquer e cole o MESMO valor aqui e lá)
CAKTO_WEBHOOK_SECRET=escolha-uma-senha-forte-e-repita-no-painel-cakto

# ---------- Admin do backoffice ----------
# Senha simples para proteger as rotas /admin/* no MVP.
# (Numa v2, trocar por autenticação de verdade com papel de admin.)
ADMIN_SECRET=escolha-outra-senha-forte-para-o-backoffice

# ---------- Alertas por e-mail (Resend) ----------
# resend.com → API Keys. Usado para avisar o admin de eventos que
# precisam de revisão manual: chargeback, reembolso, plano de webhook
# não reconhecido. Se deixar em branco, o alerta só aparece no log do
# servidor (nenhum e-mail é enviado, mas nada quebra).
RESEND_API_KEY=re_cole-aqui-a-chave
ADMIN_ALERT_EMAIL=seu-email-de-admin@exemplo.com
ALERT_FROM_EMAIL=alertas@pequenasofia.com

# ---------- Links de checkout Cakto (upgrade dentro do app) ----------
# Painel Cakto → Produtos → Ofertas → Copiar link de checkout
CHECKOUT_URL_PENSADOR=https://pay.cakto.com.br/SEU-LINK-PENSADOR
CHECKOUT_URL_FILOSOFO=https://pay.cakto.com.br/SEU-LINK-FILOSOFO

# ---------- CORS ----------
# Domínios que podem chamar esta API — o domínio do seu app
# (ex: https://app.pequenasofia.com) e, durante testes locais,
# http://localhost:3000 ou similar.
ALLOWED_ORIGINS=https://app.pequenasofia.com,http://localhost:5173

# ---------- Porta ----------
PORT=3000
